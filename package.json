{
  "name": "@th3trig3rfac3/eslint-plugin-react-router",
  "version": "0.2.2",
  "description": "ESLint rules for React Router route modules and route configuration",
  "license": "Apache-2.0",
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "download"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Th3Trig3rFac3/react-router-eslint-plugin.git"
  },
  "homepage": "https://github.com/Th3Trig3rFac3/react-router-eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/Th3Trig3rFac3/react-router-eslint-plugin/issues"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "react-router",
    "reactrouter",
    "remix",
    "routing"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.13.0"
  },
  "peerDependencies": {
    "eslint": "^10.4.0"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/rule-tester": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsdown --watch",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mocks": "vitest run tests/mocks",
    "test:perf": "vitest run tests/performance",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docs:check": "tsx scripts/verify-rule-index.ts",
    "package:check": "pnpm build && tsx scripts/verify-package.ts && publint && tsx scripts/check-package-types.ts",
    "ci": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  }
}
